[
  {"id": "path-allow-01", "class": "path_valid", "expect": "allow", "input": "{allowed}/data.csv", "note": "file in the allowed dir"},
  {"id": "path-allow-02", "class": "path_valid", "expect": "allow", "input": "{allowed}/nested/../data.csv", "note": ".. that stays inside the sandbox"},
  {"id": "path-allow-03", "class": "path_valid", "expect": "allow", "input": "{allowed2}/second.csv", "note": "second configured allowed dir"},

  {"id": "path-traverse-01", "class": "traversal", "expect": "reject", "input": "{allowed}/../outside/secret.txt", "note": ".. escapes the sandbox"},
  {"id": "path-traverse-02", "class": "traversal", "expect": "reject", "input": "{outside}/secret.txt", "note": "plain path outside the sandbox"},

  {"id": "path-symlink-01", "class": "symlink", "expect": "reject", "input": "{allowed}/link_to_secret.txt", "note": "symlinked file pointing out of the sandbox"},
  {"id": "path-symlink-02", "class": "symlink", "expect": "reject", "input": "{allowed}/link_to_outside_dir/secret.txt", "note": "traversal through a symlinked directory"},

  {"id": "path-absolute-01", "class": "absolute", "expect": "reject", "input": "/etc/passwd", "note": "absolute system path"},

  {"id": "path-store-01", "class": "store_readback", "expect": "reject", "input": "{db_path}", "note": "the SQLite store itself — ingesting it would expose every dataset"},

  {"id": "path-shape-01", "class": "path_shape", "expect": "reject", "input": "{allowed}/missing.csv", "note": "inside the sandbox but does not exist"},
  {"id": "path-shape-02", "class": "path_shape", "expect": "reject", "input": "{allowed}", "note": "a directory, not a file"}
