[
  {"id": "sql-allow-01", "class": "select_basic", "expect": "allow", "input": "SELECT * FROM orders", "note": "baseline select"},
  {"id": "sql-allow-02", "class": "select_basic", "expect": "allow", "input": "SELECT status, SUM(total) FROM orders GROUP BY status HAVING SUM(total) > 100", "note": "aggregate + group + having"},
  {"id": "sql-allow-03", "class": "select_basic", "expect": "allow", "input": "SELECT * FROM orders;", "note": "trailing semicolon is stripped, still one statement"},
  {"id": "sql-allow-04", "class": "select_join", "expect": "allow", "input": "SELECT o.id, c.name FROM orders o JOIN customers c ON o.customer_id = c.id", "note": "join"},
  {"id": "sql-allow-05", "class": "select_cte", "expect": "allow", "input": "WITH t AS (SELECT 1 AS n) SELECT * FROM t", "note": "cte root — exp.With"},
  {"id": "sql-allow-06", "class": "select_union", "expect": "allow", "input": "SELECT id FROM a UNION SELECT id FROM b", "note": "union root — exp.Union"},
  {"id": "sql-allow-07", "class": "select_subquery", "expect": "allow", "input": "SELECT * FROM (SELECT id, total FROM orders) sub WHERE sub.total > 50", "note": "derived table"},
  {"id": "sql-allow-08", "class": "select_expr", "expect": "allow", "input": "SELECT id, ROW_NUMBER() OVER (PARTITION BY status ORDER BY total) AS rn FROM orders", "note": "window function"},

  {"id": "sql-dml-01", "class": "dml_insert", "expect": "reject", "input": "INSERT INTO orders (id) VALUES (1)", "note": "plain insert"},
  {"id": "sql-dml-02", "class": "dml_insert", "expect": "reject", "input": "INSERT INTO orders SELECT * FROM staging", "note": "insert-select — write wrapped around a select"},
  {"id": "sql-dml-03", "class": "dml_update", "expect": "reject", "input": "UPDATE orders SET total = 0", "note": "update"},
  {"id": "sql-dml-04", "class": "dml_delete", "expect": "reject", "input": "DELETE FROM orders", "note": "delete"},
  {"id": "sql-dml-05", "class": "dml_replace", "expect": "reject", "input": "REPLACE INTO orders (id) VALUES (1)", "note": "sqlite REPLACE — reaches the Command fallback"},
  {"id": "sql-dml-06", "class": "dml_upsert", "expect": "reject", "input": "INSERT INTO orders (id) VALUES (1) ON CONFLICT(id) DO UPDATE SET total = 0", "note": "upsert"},

  {"id": "sql-ddl-01", "class": "ddl_drop", "expect": "reject", "input": "DROP TABLE orders", "note": "drop"},
  {"id": "sql-ddl-02", "class": "ddl_create", "expect": "reject", "input": "CREATE TABLE evil (id INTEGER)", "note": "create"},
  {"id": "sql-ddl-03", "class": "ddl_create", "expect": "reject", "input": "CREATE TABLE evil AS SELECT * FROM orders", "note": "CTAS — write disguised as a select"},
  {"id": "sql-ddl-04", "class": "ddl_alter", "expect": "reject", "input": "ALTER TABLE orders ADD COLUMN x TEXT", "note": "alter"},

  {"id": "sql-pragma-01", "class": "pragma", "expect": "reject", "input": "PRAGMA table_info(orders)", "note": "bare pragma"},
  {"id": "sql-pragma-02", "class": "pragma", "expect": "reject", "input": "PRAGMA journal_mode = DELETE", "note": "pragma that writes"},
  {"id": "sql-attach-01", "class": "attach", "expect": "reject", "input": "ATTACH DATABASE '/etc/passwd' AS x", "note": "attach an arbitrary file"},
  {"id": "sql-attach-02", "class": "attach", "expect": "reject", "input": "DETACH DATABASE x", "note": "detach"},
  {"id": "sql-maint-01", "class": "maintenance", "expect": "reject", "input": "VACUUM", "note": "vacuum rewrites the db file"},

  {"id": "sql-multi-01", "class": "multi_statement", "expect": "reject", "input": "SELECT 1; DROP TABLE orders", "note": "select then ddl"},
  {"id": "sql-multi-02", "class": "multi_statement", "expect": "reject", "input": "SELECT 1 ; ; DROP TABLE orders", "note": "empty statement between"},

  {"id": "sql-into-01", "class": "select_into", "expect": "reject", "input": "SELECT * INTO backup FROM orders", "note": "select-into writes a table"},

  {"id": "sql-comment-01", "class": "comment_smuggling", "expect": "reject", "input": "SELECT 1 -- ;DROP TABLE orders\n; DROP TABLE orders", "note": "real statement after a commented decoy"},
  {"id": "sql-comment-02", "class": "comment_smuggling", "expect": "reject", "input": "/* harmless */ DROP TABLE orders", "note": "leading block comment before ddl"},

  {"id": "sql-parse-01", "class": "unparseable", "expect": "reject", "input": "SELEKT * FORM orders", "note": "typo'd keywords — ParseError"},
  {"id": "sql-parse-02", "class": "unparseable", "expect": "reject", "input": "'; DROP TABLE orders; --", "note": "unterminated quote — TokenError, a ParseError sibling"},

  {"id": "sql-empty-01", "class": "empty", "expect": "reject", "input": "", "note": "empty string"},
  {"id": "sql-empty-02", "class": "empty", "expect": "reject", "input": ";", "note": "bare semicolon"}
]
